# =============================================================================
# backend/.env.example — contoh konfigurasi untuk PENGEMBANGAN LOKAL
# Salin menjadi backend/.env lalu isi nilainya. JANGAN dipakai untuk production;
# untuk server/Docker pakai .env.production.example di root repo
# (panduan: docs/DEPLOY.md).
# =============================================================================

# Database PostgreSQL (ganti GANTI_PASSWORD dengan password Postgres lokal Anda)
DATABASE_URL=postgres://postgres:GANTI_PASSWORD@localhost:5432/campuscare
DB_SSL=false

# Keamanan JWT: isi string acak minimal 16 karakter (disarankan 64 karakter hex).
# Buat dengan salah satu perintah:
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Bila dibiarkan kosong, backend hanya memberi peringatan di mode development,
# tetapi MENOLAK start di production.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Server Express
PORT=3000
NODE_ENV=development

# CORS: URL Frontend (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Rate Limiter autentikasi (jumlah percobaan login/register per 15 menit per IP)
AUTH_RATE_LIMIT=50

# Google OAuth 2.0 (Google Identity Services)
# Client ID dari Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=isi_client_id.apps.googleusercontent.com
# Client Secret dari Google Cloud Console (APIs & Services > Credentials)
# Catatan: Backend tidak memakainya, verifikasi ID token cukup dengan Client ID
GOOGLE_CLIENT_SECRET=
# Domain email yang diizinkan untuk masuk dengan Google (pisahkan dengan koma)
ALLOWED_EMAIL_DOMAINS=student.unsil.ac.id,unsil.ac.id
