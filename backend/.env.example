# Database PostgreSQL
DATABASE_URL=postgres://postgres:123@localhost:5432/campuscare
DB_SSL=false

# Keamanan JWT (Minimal 16 karakter acak; di production wajib diganti)
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=8h

# Server Express
PORT=3000
NODE_ENV=development

# CORS: URL Frontend (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500

# Rate Limiter autentikasi (jumlah percobaan login/register per 15 menit per IP)
AUTH_RATE_LIMIT=50

# Google OAuth 2.0 (Google Identity Services)
# Client ID dari Google Cloud Console (APIs & Services > Credentials)
GOOGLE_CLIENT_ID=isi_client_id.apps.googleusercontent.com
# Client Secret dari Google Cloud Console (APIs & Services > Credentials)
# Catatan: Backend tidak memakainya, verifikasi ID token cukup dengan Client ID
GOOGLE_CLIENT_SECRET=
# Domain email yang diizinkan untuk masuk dengan Google (pisahkan dengan koma)
ALLOWED_EMAIL_DOMAINS=student.unsil.ac.id,unsil.ac.id
