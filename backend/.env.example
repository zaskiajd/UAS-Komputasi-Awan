# ============================================================================
# CampusCare — contoh environment variable backend
# Salin file ini menjadi .env lalu sesuaikan nilainya:
#   cp .env.example .env
#
# JANGAN commit file .env. Nilai di bawah hanya contoh, bukan secret asli.
# ============================================================================

# Connection string PostgreSQL (wajib).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/campuscare

# true bila database cloud mewajibkan SSL.
DB_SSL=false

# Wajib diganti dengan string acak minimal 16 karakter (disarankan 32+).
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter

# Port HTTP server backend.
PORT=3000

# Origin frontend yang diizinkan; pisahkan dengan koma bila lebih dari satu.
CORS_ORIGIN=http://localhost:8000

# development | production
NODE_ENV=development
