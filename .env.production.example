# =============================================================================
# .env.production.example — TEMPLATE konfigurasi production CampusCare (Docker)
# -----------------------------------------------------------------------------
# SATU berkas ini dipakai oleh docker-compose.yml DAN backend.
#
# Cara pakai di server (folder repo):
#   cp .env.production.example .env
#   nano .env            # ganti semua nilai HURUF_BESAR dan isi yang kosong
#   chmod 600 .env       # hanya pemilik yang boleh membaca
#
# DEPLOY WAJIB LEWAT SSH ke VM1 (192.168.122.161):
#   deploy/scripts/deploy.sh
# JANGAN deploy lewat Portainer "Repository": build image gagal melalui
# Portainer Agent dengan error "http2 frame too large". Portainer hanya dipakai
# untuk menghentikan stack web1 agar port 8081 bebas.
#
# ATURAN PENULISAN:
#   - Format KEY=nilai, tanpa spasi di sekitar "=", tanpa tanda kutip.
#   - Komentar ditulis di baris sendiri (diawali #), jangan di belakang nilai.
#   - Berkas .env berisi rahasia: JANGAN di-commit ke git (sudah di .gitignore).
#   - JANGAN memakai backend/.env.example untuk production; itu untuk lokal.
# =============================================================================

# --- Server -------------------------------------------------------------------

# Mode aplikasi. Biarkan "production" (backend menolak JWT_SECRET lemah).
NODE_ENV=production

# Port Express DI DALAM container. Jangan diubah: Nginx menuju api:3000.
PORT=3000

# Port di VM1 (host) yang dibuka oleh container Nginx. Cloudflare Tunnel
# (berjalan di HOST DEBIAN, bukan di dalam VM) sudah mengarahkan hostname
# web1.kelompok5-iass.my.id → http://192.168.122.161:8081. Karena itu tunnel
# TIDAK perlu diubah. Sebelum deploy, hentikan dulu stack "web1" di Portainer
# agar port 8081 bebas (stack web2 di 8082 tidak perlu dihentikan).
WEB_PORT=8081

# --- Database (PostgreSQL di VM lain) ----------------------------------------

# Format: postgres://USER:PASSWORD@IP_ATAU_HOST:PORT/NAMA_DATABASE
# Database CampusCare ada di VM2: 192.168.122.28:5432, database "campuscare".
# Contoh: postgres://campuscare:SandiKuat@192.168.122.28:5432/campuscare
# Buat user/database dan izinkan 192.168.122.161/32 di pg_hba.conf VM2
# (lihat docs/DEPLOY.md Bagian 5). Skrip deploy menolak nilai contoh yang masih
# mengandung "USER:PASSWORD@" agar tidak lupa diisi.
# Bila password mengandung karakter khusus (@ : / ? # %), tulis versi
# URL-encode-nya, mis. @ menjadi %40, # menjadi %23.
DATABASE_URL=postgres://USER:PASSWORD@192.168.122.28:5432/campuscare

# true hanya bila server database mewajibkan SSL (umumnya database cloud).
# Untuk Postgres di VM lokal/kampus biasanya false.
DB_SSL=false

# (Opsional) Jumlah maksimal koneksi dari backend ke database. Default 10.
DB_POOL_MAX=10

# --- Keamanan login (JWT) ----------------------------------------------------

# WAJIB diisi string acak panjang. Buat di server dengan perintah:
#   openssl rand -hex 32
# lalu tempel hasilnya di sini. Backend MENOLAK start bila kosong, kurang dari
# 16 karakter, atau berisi nilai contoh (ganti_ini, secret, changeme, password).
# Mengganti nilai ini membuat semua pengguna harus login ulang.
JWT_SECRET=

# Lama token login berlaku (contoh: 8h = 8 jam, 1d = 1 hari).
JWT_EXPIRES_IN=8h

# --- CORS --------------------------------------------------------------------

# Alamat publik website, TANPA garis miring di akhir. Frontend dan API satu
# domain, tetapi tetap isi agar backend mengenali origin yang sah.
# Hostname CampusCare di lingkungan tim adalah web1.kelompok5-iass.my.id.
# Lebih dari satu? pisahkan dengan koma.
CORS_ORIGIN=https://web1.kelompok5-iass.my.id

# Batas percobaan login/registrasi per IP per 15 menit (anti brute-force).
AUTH_RATE_LIMIT=50

# --- Unggahan foto pengaduan -------------------------------------------------

# Folder penyimpanan foto DI DALAM container. Jangan diubah: docker-compose.yml
# memasang named volume "campuscare_uploads" di path ini. Foto akan hilang bila
# volume dihapus (mis. "docker compose down -v") tanpa backup.
UPLOAD_DIR=/app/uploads

# Batas permintaan unggah/hapus foto per IP per 15 menit. Default 30.
UPLOAD_RATE_LIMIT=30

# --- Google Login (Google Identity Services) ---------------------------------

# Client ID OAuth 2.0 dari Google Cloud Console (APIs & Services → Credentials).
# Harus SAMA dengan GOOGLE_CLIENT_ID di js/config.js. Kosong = login Google
# ditolak backend, login email + sandi tetap berjalan.
GOOGLE_CLIENT_ID=

# Catatan: backend TIDAK memakai Client Secret (verifikasi ID token cukup
# dengan Client ID). Boleh dibiarkan kosong.
GOOGLE_CLIENT_SECRET=

# Domain email yang boleh login dengan Google (pisahkan dengan koma).
ALLOWED_EMAIL_DOMAINS=student.unsil.ac.id,unsil.ac.id

# --- Cloudflare Tunnel (TIDAK DIPAKAI DI VM) ----------------------------------------------

# Tunnel berjalan di HOST DEBIAN (di luar VM) dan route-nya sudah:
#   web1.kelompok5-iass.my.id → http://192.168.122.161:8081
# Jangan memasang/menjalankan cloudflared di VM dan jangan mengaktifkan profile
# "tunnel" di docker-compose.yml. Biarkan token ini kosong. Bila route perlu
# diubah, lakukan di host Debian / dashboard Cloudflare, bukan di repo ini.
CLOUDFLARE_TUNNEL_TOKEN=
